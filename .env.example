# Allowed values: local, dev, staging, production (dev follows the staging
# rules). Unset is treated as production, which is the strictest set of rules,
# and an unrecognized value refuses to boot — see
# "Configuration and boot guard" in README.md.
APP_ENV=local
# Exposes exception messages and stack traces in API error responses. Refused
# with APP_ENV=production — the app will not boot with both set.
APP_DEBUG=true
APP_URL=http://localhost:8081
# Release identifier surfaced by GET /api/v1/health (git sha, tag, or "dev").
APP_VERSION=2026xxxx-x
# Comma-separated, exact front-end origins (scheme://host[:port], no path or
# trailing slash). Required in dev, staging and production, where "*" is forbidden;
# production additionally requires every origin to use https. If unset in
# local, these same dev origins are used as the default. Credentials
# (cookies) are never allowed regardless of this setting — the API
# authenticates with a Bearer token only.
APP_CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080,http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
# Required in EVERY environment, at least 32 bytes, and not a "change-me..."
# placeholder outside local. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
# The app answers 503 until this is set correctly. Rotating it logs everyone
# out (all existing JWTs stop verifying).
JWT_SECRET=
JWT_TTL_SECONDS=86400
# Staging/dev only (ignored on local, where demo accounts use demo1234). When set,
# `composer seed` gives every seeded demo account this password instead of
# scrubbing it. At least 8 characters, never demo123/demo1234; keep it out of the repo.
# SEED_DEMO_PASSWORD=
APP_UPLOAD_DIR=public/uploads
APP_UPLOAD_PUBLIC_BASE=/uploads
APP_UPLOAD_MAX_BYTES=5242880

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zmierzymy_czas
DB_USERNAME=root
DB_PASSWORD=

# E1.6: trasa A (bramka) — Tpay Transactions API (https://docs-api.tpay.com/).
# Placeholders below are non-functional on purpose: leave TPAY_CLIENT_ID/SECRET
# empty (or unset) for local dev/CI — RegistrationRepository then skips starting
# a payment session entirely instead of trying (and failing) a real call. Fill
# these in with real sandbox or production values (Tpay Merchant Panel ->
# Integration > API -> "Add new key") to actually exercise the gateway.
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
TPAY_MERCHANT_ID=
# true = openapi.sandbox.tpay.com, false = api.tpay.com (production).
# Must be explicitly false when APP_ENV=production — the API refuses to boot
# otherwise (unset defaults to true, fail-closed). Use true/false, not 1/0.
TPAY_SANDBOX=true
# Must be publicly reachable by Tpay's servers — a localhost APP_URL will not
# receive webhook callbacks; override with a tunnel/staging URL for real testing.
TPAY_NOTIFICATION_URL=
# Where the payer's browser is sent back to after paying (or after a failure).
# Defaults to {APP_URL}/platnosc/sukces and /platnosc/blad when left empty.
TPAY_SUCCESS_URL=
TPAY_ERROR_URL=

# E1.7: trasa A (bramka) — PayNow API v1 (https://docs.paynow.pl/docs/v1/integration).
# Placeholders below are non-functional on purpose: leave PAYNOW_API_KEY/
# PAYNOW_SIGNATURE_KEY empty (or unset) for local dev/CI — RegistrationRepository
# then skips starting a PayNow session entirely instead of trying (and failing)
# a real call. Fill these in with real sandbox or production values (PayNow
# Merchant Panel -> Ustawienia -> Sklepy i kasy -> Autoryzacja) to actually
# exercise the gateway. Which Wydarzenia use PayNow vs Tpay is a separate
# choice (payment_config.provider on the event), not controlled by these vars.
PAYNOW_API_KEY=
PAYNOW_SIGNATURE_KEY=
# true = api.sandbox.paynow.pl, false = api.paynow.pl (production).
# Must be explicitly false when APP_ENV=production — the API refuses to boot
# otherwise (unset defaults to true, fail-closed). Use true/false, not 1/0.
PAYNOW_SANDBOX=true
# Informational only: PayNow's v1 API has no per-request notification-url field
# — the callback URL is configured once in the Merchant Panel, against the
# point-of-sale PAYNOW_API_KEY belongs to. This documents what that setting
# should point at; it is never sent in a request body.
PAYNOW_NOTIFICATION_URL=
# Where the payer's browser is sent back to after paying. PayNow has a single
# continueUrl (unlike Tpay's separate success/error urls) and it is optional —
# defaults to {APP_URL}/platnosc/sukces when left empty.
PAYNOW_CONTINUE_URL=

# E1.9: Central Mailer — technical integration layer only (client + own outbox).
# Actual email content/catalog ("katalog maili krytycznych") is a separate, later
# ticket (E1.10); nothing here sends a real message on its own. Placeholders
# below are non-functional on purpose: leave CENTRAL_MAILER_API_KEY/
# CENTRAL_MAILER_BASE_URL empty for local dev/CI — CentralMailerConfig::
# isConfigured() then reports false and callers must skip sending rather than
# attempt a call that would only fail, exactly like TPAY_*/PAYNOW_* above.
# NOTE: production also needs its own dedicated API key provisioned MANUALLY in
# Central Mailer's own .env before launch (kontrakt-central-mailer.md §9 point
# 9 — production's .env today only has API_KEY_APP_A for the sibling
# biuro_zawodow project; this platform needs its own, second key). That is a
# deployment task, not something this codebase can do.
CENTRAL_MAILER_API_KEY=
# Base URL of the Central Mailer install, no trailing slash (e.g.
# https://mailer.zmierzymyczas.pl) — CENTRAL_MAILER_BASE_URL is joined directly
# with paths like "/emails".
CENTRAL_MAILER_BASE_URL=

# E3.1: "Klucz API per aplikacja" (wzorzec Central Mailera) — authenticates
# INCOMING calls from external applications (Biuro Zawodów first, more later)
# via the `X-API-Key` header, ApplicationApiKeyConfig/ApiKeyAuthMiddleware.
# Format: comma-separated "application=key" pairs, e.g.
# "biuro_zawodow=<random-secret>,other_app=<other-secret>" — adding a second
# calling application later means adding one more pair here, not touching the
# code. Leave a real application's placeholder out of dev/CI; put actual
# per-application secrets here only in real deployments.
# NOTE the direction is the OPPOSITE of TPAY_*/PAYNOW_*/CENTRAL_MAILER_* above:
# those configure OUTGOING calls this platform makes, where "unset" safely
# means "skip the call". This gates INCOMING access, so "unset" (the default
# below) means "nothing is authorized" — every request is rejected until at
# least one pair is configured (fail closed, not fail open).
INCOMING_API_KEYS=

# E3.4: "Push zmian krytycznych (rezygnacja, zwrot) webhookiem" — where this
# platform sends its OUTGOING webhook calls to Biuro Zawodów (opposite
# direction from E3.3's pull, which BZ calls into this platform). No separate
# API key lives here: the outbound call authenticates with the affected
# Event's own bz_organization_token (E3.2) instead, the same credential BZ
# already presents back on its pull — see BzWebhookConfig's doc comment.
# Placeholder below is non-functional on purpose: leave BZ_WEBHOOK_BASE_URL
# empty for local dev/CI — BzWebhookConfig::isConfigured() then reports false
# and RegistrationRepository skips the push entirely rather than attempting a
# call that would only fail, exactly like TPAY_*/PAYNOW_*/CENTRAL_MAILER_*
# above. Doubly true today regardless of this setting: Biuro Zawodów has not
# built its receiving endpoint yet (separate repo/team backlog item).
BZ_WEBHOOK_BASE_URL=
