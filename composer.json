{
    "name": "zmierzymy-czas/server",
    "description": "REST API for the Zmierzymy Czas frontend.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ZmierzymyCzas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZmierzymyCzas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8081 -t public router.php"
        ],
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "test": "phpunit",
        "lint": [
            "php -l public/index.php",
            "php -l bin/migrate.php",
            "php -l bin/seed.php",
            "php -l bin/prune-demo.php",
            "php -l src/Database/Migrator.php",
            "php -l src/Database/CustomFormFieldsBackfill.php",
            "php -l src/Database/QrCodeBackfill.php",
            "php -l src/Database/CompetitorProfileBackfill.php",
            "php -l src/Support/QrCode.php",
            "php -l src/Support/Env.php",
            "php -l src/Database/SeedManifest.php",
            "php -l src/Database/DemoData.php",
            "php -l src/Database/EventFixtureImporter.php",
            "php -l src/Database/FixtureCalendar.php",
            "php -l src/Database/FixtureFieldFiller.php",
            "php -l src/Database/EventCoherence.php",
            "php -l src/Domain/Events/EventRepository.php",
            "php -l src/Domain/Competitors/CompetitorRepository.php",
            "php -l src/Domain/Care/CareRepository.php",
            "php -l src/Domain/Registrations/RegistrationRepository.php",
            "php -l src/Domain/Registrations/StartListExportFormatter.php",
            "php -l src/Http/routes.php",
            "php -l database/seeders/generate_events.php",
            "php -l src/Database/ShopFixtureImporter.php",
            "php -l src/Database/SeriesLinker.php",
            "php -l src/Domain/Challenges/ChallengeRepository.php",
            "php -l src/Domain/Challenges/ChallengePointsSettingsRepository.php",
            "php -l src/Domain/Challenges/ChallengePointThresholdScorer.php",
            "php -l src/Domain/Challenges/ChallengeConditionTreeEvaluator.php",
            "php -l src/Domain/Mailer/CriticalMails/MailCatalog.php",
            "php -l src/Domain/Mailer/CriticalMails/MailRenderer.php",
            "php -l src/Domain/Mailer/CriticalMails/MailTemplateRepository.php",
            "php -l src/Domain/Mailer/CriticalMails/CriticalMailer.php",
            "php -l src/Domain/Mailer/CentralMailer/CentralMailerOutboxRepository.php",
            "php -l src/Domain/Mailer/CentralMailer/CentralMailerOutboxService.php",
            "php -l src/Domain/Bz/Http/HttpClientInterface.php",
            "php -l src/Domain/Bz/Http/HttpResponse.php",
            "php -l src/Domain/Bz/Http/CurlHttpClient.php",
            "php -l src/Domain/Bz/BzWebhookConfig.php",
            "php -l src/Domain/Bz/BzWebhookClientInterface.php",
            "php -l src/Domain/Bz/BzWebhookClient.php",
            "php -l src/Domain/Bz/BzWebhookOutboxRepository.php",
            "php -l src/Domain/Bz/BzWebhookOutboxService.php",
            "php -l src/Domain/FormFields/FormFieldCatalog.php",
            "php -l src/Domain/FormFields/FormFieldType.php",
            "php -l src/Domain/FormFields/FormFieldRepository.php",
            "php -l src/Domain/FormFields/FormFieldAnswerRepository.php"
        ],
        "seed:fresh": "php bin/seed.php --fresh",
        "seed:purge": "php bin/seed.php --purge",
        "prune-demo": "php bin/prune-demo.php --dry-run"
    }
}
