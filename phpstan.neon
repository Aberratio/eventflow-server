includes:
    - phpstan-baseline.neon

parameters:
    # Starting level for a codebase with no prior static analysis. Level 4 catches
    # real bugs (wrong argument/return types, dead catch blocks, always-true/false
    # conditions, calling methods on possibly-null values, etc.) without requiring
    # the full property-typehint/generics discipline that higher levels demand.
    # Ratchet this up over time (see TD.15 in the backlog).
    level: 4
    tmpDir: var/phpstan
    paths:
        - src
        - bin
        - public
        - database
