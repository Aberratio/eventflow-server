{
    "name": "zmierzymy-czas/server",
    "description": "REST API for the Zmierzymy Czas frontend.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.15.3",
        "slim/psr7": "^1.7",
        "firebase/php-jwt": "^7.0",
        "ezyang/htmlpurifier": "^4.18",
        "monolog/monolog": "^3.7",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ZmierzymyCzas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZmierzymyCzas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8081 -t public router.php"
        ],
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "test": "phpunit",
        "lint": "php bin/lint.php",
        "seed:fresh": "php bin/seed.php --fresh",
        "seed:purge": "php bin/seed.php --purge",
        "prune-demo": "php bin/prune-demo.php --dry-run",
        "test:prepare": "php tests/bin/test-db.php prepare",
        "e2e:bz": "php tests/e2e/bz/run.php",
        "stan": "phpstan analyse --no-progress",
        "cs": "phpcs"
    }
}
